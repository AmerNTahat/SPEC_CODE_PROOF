#!/bin/sh
# Prefer the existing compatible repository environment; no downloads or installs.
set -eu
repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -n "${INSPECTA_PYTHON:-}" ]; then
    python_bin=$INSPECTA_PYTHON
elif [ -x "$repo_dir/.venv/bin/python" ]; then
    python_bin=$repo_dir/.venv/bin/python
else
    python_bin=python3
fi
"$python_bin" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else "Python 3.11+ required; set INSPECTA_PYTHON to an existing interpreter")'
export PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="$repo_dir/workbench"
exec "$python_bin" -m inspecta_scp.cli "$@"
