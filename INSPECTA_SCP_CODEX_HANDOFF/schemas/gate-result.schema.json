{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "record_type": {
      "const": "gate_result"
    },
    "run_id": {
      "type": "string"
    },
    "gate_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_RUN",
        "NOT_APPLICABLE"
      ]
    },
    "artifact_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "tool_identity": {
      "type": [
        "string",
        "null"
      ]
    },
    "operation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "command_argv": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_cases": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "rejected_cases": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "failed_cases": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "evidence_references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "$schema",
    "schema_version",
    "record_type",
    "run_id",
    "gate_id",
    "status",
    "artifact_digest",
    "policy_digest",
    "tool_identity",
    "operation_id",
    "command_argv",
    "exit_code",
    "observed_at",
    "valid_cases",
    "rejected_cases",
    "failed_cases",
    "evidence_references",
    "approval_reference",
    "notes"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "artifact_digest": {
            "type": "string",
            "minLength": 1
          },
          "policy_digest": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "minLength": 1
          },
          "evidence_references": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "NOT_APPLICABLE"
          }
        }
      },
      "then": {
        "properties": {
          "approval_reference": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
