# Configuration names for the Workbench to implement; not a secret store.
# Resolve the real model ID through the installed Codex/account during setup.
SCP_MODEL_PROFILE=astra
SCP_MODEL_ID=
SCP_BIND_HOST=127.0.0.1
SCP_WORKSPACE_ROOT=
SCP_TOOLCHAIN_LOCK=
# Do not put model tokens, auth.json, private signing keys or evaluator paths here.
# Follow the trusted credential-broker/isolated agent design in Goal 04.

# Optional existing executable selections; edit actual paths before use.
# These helpers read shell environment, not this template automatically.
# CODEX_BIN=/absolute/path/to/downloaded/codex-v_155
# SIREUM_HOME=/absolute/path/to/Sireum
# SIREUM_BIN=/absolute/path/to/Sireum/bin/sireum
