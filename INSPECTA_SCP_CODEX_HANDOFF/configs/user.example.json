{
  "$schema": "../schemas/run-profile.schema.json",
  "schema_version": "2.0",
  "kind": "run_profile",
  "readiness": "draft",
  "mode": "user",
  "assistance": "automatic",
  "project_config": null,
  "learning_materials": null,
  "development_validation": null,
  "rule_release": null,
  "toolchain_lock": null,
  "model": {
    "family": "gpt",
    "requested_profile": "astra",
    "resolved_model_id": null,
    "codex_version": null
