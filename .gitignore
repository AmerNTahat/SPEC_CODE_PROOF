# Ignore everything at repo root
/*

# Keep this .gitignore
!.gitignore

# Keep the codex_mcp_workflow directory itself
!codex_mcp_workflow/

# Inside codex_mcp_workflow: ignore everything by default
codex_mcp_workflow/*

# Re-allow directory traversal within codex_mcp_workflow
!codex_mcp_workflow/**/

# Keep only Python source files (recursively)
!codex_mcp_workflow/*.py
!codex_mcp_workflow/**/*.py

# Keep markdown files
!codex_mcp_workflow/*.md
codex_mcp_workflow/isolette/sysml/sysml-aadl-libraries/

# Selective Workbench checkpoint
!/README.md
!/inspecta-scp
!/workbench/
!/scripts/
!/examples/
!/rulebooks/
!/docs/
!/reports/
/reports/*
!/reports/checkpoint/
.venv/
node_modules/
dist/
__pycache__/
*.py[cod]
.env
.env.*
*.pem
*.key
/.scp-workbench/
/workbench/default-toolchain.local.json

# Original handoff baseline, including the reviewed empty environment template
!/INSPECTA_SCP_CODEX_HANDOFF/
!/INSPECTA_SCP_CODEX_HANDOFF/templates/.env.example
