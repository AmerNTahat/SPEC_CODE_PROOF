    "text": "package ProdCons {\n  private import HAMR::*;\n  private import Base_Types::Integer_32;\n\n  public part def ProdCons_System :> AADL::System {\n    part prod : Prod_Process;\n    part cons : Cons_Process;\n    part proc : Main_Processor;\n\n    connection pc : AADL::PortConnection connect prod.output to cons.input;\n    allocation prod_to_proc : Deployment_Properties::Actual_Processor_Binding allocate prod to proc;\n    allocation cons_to_proc : Deployment_Properties::Actual_Processor_Binding allocate cons to proc;\n  }\n\n  part def Prod_Process :> HAMR_AADL::Process {\n    attribute Domain_Prod : CASE_Scheduling::Domain = 2;\n\n    port output : AADL::EventDataPort {\n      out :>> type : Message;\n    }\n    part prod : Prod;\n    connection prod_output : AADL::PortConnection connect prod.output to output;\n  }\n\n  part def Cons_Process :> HAMR_AADL::Process {\n    attribute Domain_Cons : CASE_Scheduling::Domain = 3;\n\n    port input : AADL::EventDataPort {\n      in :>> type : Message;\n    }\n    part cons : Cons;\n    connection cons_input : AADL::PortConnection connect input to cons.input;\n  }\n\n  part def Prod :> HAMR_AADL::Thread {\n    attribute :>> Dispatch_Protocol = AADL_Project::Supported_Dispatch_Protocols::Periodic;\n    attribute :>> Period = 60 [ms];\n    attribute :>> Implementation_Language = HAMR::Implementation_Languages::Rust;\n\n    port output : AADL::EventDataPort {\n      out :>> type : Message;\n    }\n\n    language \"GUMBO\" /*{\n      integration\n        guarantee Payload_Range:\n          output.payload >= 0[s32] and\n          output.payload <= 90[s32];\n    }*/\n  }\n\n  part def Cons :> HAMR_AADL::Thread {\n    attribute :>> Dispatch_Protocol = AADL_Project::Supported_Dispatch_Protocols::Periodic;\n    attribute :>> Period = 40 [ms];\n    attribute :>> Implementation_Language = HAMR::Implementation_Languages::Rust;\n\n    port input : AADL::EventDataPort {\n      in :>> type : Message;\n    }\n\n    language \"GUMBO\" /*{\n      state\n        payload_sum: Base_Types::Integer_32;\n\n      functions\n        def Init_Payload_Sum(): Base_Types::Integer_32 := 0[s32];\n\n      integration\n        assume Payload_Range:\n          input.payload >= 0[s32] and\n          input.payload <= 100[s32];\n\n      initialize\n        guarantee initSum:\n          payload_sum == Init_Payload_Sum();\n    }*/\n    // Compute behavior is unspecified by the supplied requirements.\n  }\n\n  part def Message :> AADL::Data {\n    part payload : Integer_32;\n    part control_num : Integer_32;\n  }\n\n  part def Main_Processor :> HAMR_AADL::Processor {\n    attribute :>> Frame_Period = 120 [ms];\n    attribute :>> Clock_Period = 2 [ms];\n  }\n}\n",
